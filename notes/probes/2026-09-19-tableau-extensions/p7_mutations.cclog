five_card_biased_proximity_at_singleton
     : forall (R : realType) (i : 'I_5),
       var_dist
         (fdistmap
            (fun u : sa_sampleT (amf_sample kim_biased_family R tt) =>
             (sa_coalition_view 0 [set i] u, Secret R u))
            (sa_sampleP (amf_sample kim_biased_family R tt)))
         (fdistmap (sa_coalition_view 0 [set i]) (P R))
         `x (fdistmap (Secret R) (P R)) <=
       1 / 50

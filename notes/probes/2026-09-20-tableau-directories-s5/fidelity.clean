     : Tableau Sampled
s5_dealt_splitE
:
(s5_dealt_executable;;; execute_step
 of obs_payload (tableau_at s5_dealt_executable) s5_dealt_terminates
      s5_dealt_endpoints s5_dealt_recon) =
s5_dealt
     : (s5_dealt_executable;;; execute_step
        of obs_payload (tableau_at s5_dealt_executable) s5_dealt_terminates
             s5_dealt_endpoints s5_dealt_recon) =
       s5_dealt
s5_supplied_splitE
:
(s5_supplied_executable;;; execute_step
 of obs_payload (tableau_at s5_supplied_executable) s5_supplied_terminates
      s5_supplied_endpoints s5_supplied_recon) =
s5_supplied
     : (s5_supplied_executable;;; execute_step
        of obs_payload (tableau_at s5_supplied_executable)
             s5_supplied_terminates s5_supplied_endpoints s5_supplied_recon) =
       s5_supplied
s5_row_rand_splitE
:
(s5_rand_sampled certify ExactIndependence s5_rand_exact_witness
 |> publish StaticExecutedOnly (AcceptsAxioms [:: AxS5GroupOrder])) =
s5_row_rand_tableau
     : (s5_rand_sampled certify ExactIndependence s5_rand_exact_witness
        |> publish StaticExecutedOnly (AcceptsAxioms [:: AxS5GroupOrder])) =
       s5_row_rand_tableau

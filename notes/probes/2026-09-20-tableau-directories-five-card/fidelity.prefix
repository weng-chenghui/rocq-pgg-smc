five_card_reprice39 = fun R : realType => Some (2 ^- 39 : R)
     : Reprice

Arguments five_card_reprice39 R
five_card_reprice_inv25 = fun R : realType => Some (1 / 25 : R)
     : Reprice

Arguments five_card_reprice_inv25 R
five_card_reprice_inv100 =
fun R : realType => Some (1 / 100 : R)
     : Reprice

Arguments five_card_reprice_inv100 R
kim_biased_proximity_cert =
fun (R : realType) (idx : unit) =>
{|
  ipc_ideal := amf_sample five_card_uniform_family R idx;
  ipc_witness := five_card_exact_witness R idx;
  ipc_secret := Secret R;
  ipc_eps := 1 / 50;
  ipc_close :=
    fun C : {set 'I_(pi_T' (mp_PI (instance_profile five_card_algebra))).+1} =>
    fun=> kim_biased_proximity_close R C
|}
     : forall (R : realType) (idx : unit),
       IdealProximityCert (amf_sample kim_biased_family R idx)

Arguments kim_biased_proximity_cert R idx

five_card_reprice_inv25_lt2
     : forall R : realType, 1 / 25 < 2
five_card_row_repeated_endpoint_lt
     : forall (R : realType) (s : 'I_5),
       var_dist
         (fdistmap ((fun_of_perm (T:='I_5))^~ s)
            (sa_cut_dist (amf_sample kim_centi_family R tt)))
         (fdist_uniform (card_ord 5)) <
       2 ^- 40
kim_centi_small
     : forall R : realType, 0 < 5^-1 - `|1 / 100|
five_card_row_biased_leak_bound
     : forall (R : realType) (A : seq nat),
       cond_mutual_info
         `p_ [% kim_inputs (kim_centi_lt R) (kim_centi_gt R), 
         fun w : Omega => five_card_exec_colour_view A w.1 (fc_sigma ^+ w.2), 
         kim_secret (kim_centi_lt R) (kim_centi_gt R)] <=
       kim_leak_bound (1 / 100)
five_card_target
     : Targeted
five_card_F
     : Functionality (oe_inputT five_card_observed)
         (oe_outT five_card_observed)
five_card_FE
     : five_card_F =
       {| fn_f := fun ab : bool * bool => ab.1 && ab.2; fn_threshold := 1 |}
five_card_F_ite
     : fn_f five_card_F =
       (fun ab : bool * bool => if ab.1 then ab.2 else false)
five_card_realises_expected
     : realises_expected five_card_observed five_card_F
five_card_uniform_pairE
     : forall R : realType,
       fdist_uniform card_bool2 = fdist_uniform five_card_card_bool2
five_card_reading_secretE
     : forall (R : realType)
         (C : {set 'I_(pi_T' (mp_PI (instance_profile five_card_algebra))).+1})
         (d : {fdist Omega}),
       fdistmap
         (fun u : Omega =>
          (static_coalition_obs C (five_card_sample_arg u)
             (five_card_sample_cut u),
           Secret R u))
         d =
       fdistmap
         (fun
            ag : bool * bool *
                 pgg_gT (mp_M (instance_profile five_card_algebra)) =>
          (static_coalition_obs C ag.1 ag.2, ag.1.1 && ag.1.2))
         (fdistmap (fun u : Omega => (u.1, five_card_sample_cut u)) d)
five_card_arg_cut_prodE
     : forall (R : realType) (W : {fdist 'I_5}),
       fdistmap (fun u : Omega => (u.1, five_card_sample_cut u))
         (fdist_uniform five_card_card_bool2) `x W =
       (fdist_uniform five_card_card_bool2)
       `x (fdistmap (fun k : 'I_5 => (fc_sigma ^+ k)%g) W)
kim_biased_proximity_close
     : forall (R : realType)
         (C : {set 'I_(pi_T' (mp_PI (instance_profile five_card_algebra))).+1}),
       var_dist
         (fdistmap
            (fun u : Omega =>
             (static_coalition_obs C (five_card_sample_arg u)
                (five_card_sample_cut u),
              Secret R u))
            (kim_input_dist (kim_centi_lt R) (kim_centi_gt R)))
         (fdistmap
            (fun u : Omega =>
             (static_coalition_obs C (five_card_sample_arg u)
                (five_card_sample_cut u),
              Secret R u))
            (P R)) <=
       1 / 50
kim_biased_proximity_cert
     : forall (R : realType) (idx : unit),
       IdealProximityCert (amf_sample kim_biased_family R idx)
kim_biased_proximity_cert_idealE
     : forall (R : realType) (idx : unit),
       ipc_ideal (kim_biased_proximity_cert R idx) =
       amf_sample (ab_f (published_at five_card_row_uniform_tableau)) R idx /\
       ExactIndependence (ipc_witness (kim_biased_proximity_cert R idx)) =
       ab_port (published_at five_card_row_uniform_tableau) R idx
kim_biased_proximity_cert_epsE
     : forall (R : realType) (idx : unit),
       ipc_eps (kim_biased_proximity_cert R idx) = 1 / 50
kim_biased_proximity_eps_halfE
     : forall (R : realType) (idx : unit),
       cert_eps (kim_biased_cert_exact R idx) =
       ipc_eps (kim_biased_proximity_cert R idx) +
       ipc_eps (kim_biased_proximity_cert R idx)
kim_biased_proximity_cert_eps_lt2
     : forall (R : realType) (idx : unit),
       ipc_eps (kim_biased_proximity_cert R idx) < 2

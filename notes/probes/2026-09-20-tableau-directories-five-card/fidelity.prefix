         (published_row five_card_row_repeated_indistinguishability_tableau) =
       BaselineClassicalOnly
five_card_row_biased_indistinguishability_publishedE
     : apr_completion
         (published_row five_card_row_biased_indistinguishability_tableau) =
       AnalysisBridged /\
       apr_transfer
         (published_row five_card_row_biased_indistinguishability_tableau) =
       IdealFinite /\
       apr_assumptions
         (published_row five_card_row_biased_indistinguishability_tableau) =
       BaselineClassicalOnly
five_card_pow2_39_split
     : forall R : realType, 2 ^- 40 + 2 ^- 40 = 2 ^- 39
kim_centi_cert_epsE
     : forall (R : realType) (idx : unit),
       cert_eps (kim_centi_cert R idx) =
       Num.ExtraDef.sqrtr 5 * (1 / 80) ^+ 7 +
       Num.ExtraDef.sqrtr 5 * (1 / 80) ^+ 7
kim_centi_cert_eps_lt
     : forall (R : realType) (idx : unit),
       cert_eps (kim_centi_cert R idx) < 2 ^- 39
kim_biased_cert_epsE
     : forall (R : realType) (idx : unit),
       cert_eps (kim_biased_cert R idx) =
       Num.ExtraDef.sqrtr 5 * (1 / 80) + Num.ExtraDef.sqrtr 5 * (1 / 80)
kim_biased_cert_eps_lt2
     : forall (R : realType) (idx : unit),
       cert_eps (kim_biased_cert R idx) < 2
